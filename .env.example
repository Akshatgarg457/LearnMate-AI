# LearnMate AI — Environment Variables
# Set these values in the environment that starts the backend (Spring Boot does
# not load .env files automatically). Keep real values out of version control.

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/learnmate?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=learnmate_user
DB_PASSWORD=your_strong_password_here
# update creates/updates tables on start; use validate once the schema is stable.
JPA_DDL_AUTO=update

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 256 bits (32+ random characters). Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_random_hex_chars
JWT_EXPIRY_MS=86400000
JWT_REFRESH_EXPIRY_MS=604800000

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── AI Tutor: Google Gemini ───────────────────────────────────────────────────
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
# This key is separate from the Google Meet OAuth client below.
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS=1000

# ── Code Execution Judge ─────────────────────────────────────────────────────
JUDGE_BASE_URL=https://your-judge0-instance.example.com
JUDGE_API_KEY=your_judge_api_key

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# ── Google Meet (OAuth 2.0 Authorization Code) ────────────────────────────────
# Enable "Google Meet API" in Google Cloud Console, configure the OAuth consent
# screen, then create an OAuth client of type "Web application".
# The authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI exactly.
# These client credentials are separate from AI_API_KEY (Gemini).
# Requested scope: https://www.googleapis.com/auth/meetings.space.created
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_OAUTH_FRONTEND_URL=http://localhost:5173
# Encrypts Google access/refresh tokens at rest (AES-GCM); at least 32 random characters.
# Generate with: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=replace_with_at_least_32_random_hex_chars
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
