# Environment files and secrets. Keep example files tracked.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Node.js / Vite
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Java / Maven
target/
**/target/
*.class
*.jar
*.war
hs_err_pid*

# Logs
*.log
logs/
**/logs/

# Runtime data and user uploads (never publish uploaded notes or local databases)
uploads/
**/uploads/
*.db
*.sqlite
*.sqlite3
*.mdb
*.dump
*.sql.gz
*.bak
*.backup
*.zip
*.pid

# Local Spring configuration overrides
application-local.*
**/application-local.*
application-secret.*
**/application-secret.*

# Tool caches, coverage and temporary directories
.vite/
**/.vite/
coverage/
**/coverage/
.cache/
**/.cache/
tmp/
**/tmp/
.history/

# IDE and operating system files
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini